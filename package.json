{
  "name": "amigo-secreto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "deploy": "npm run build && firebase deploy",
    "test:rules": "firebase emulators:exec --only firestore --project demo-amigo-secreto \"vitest run --config vitest.rules.config.ts\"",
    "dev:local": "firebase emulators:exec --only auth,firestore --project demo-amigo-secreto \"vite --mode emulators\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "firebase-tools": "^14.9.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
